{
  "framework": "vite",
  "buildCommand": "bun run typecheck && bun run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sounds/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sounds/bank/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=31536000, immutable"
        }
      ]
    }
  ]
}
